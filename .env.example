# Шаблон. Скопируй в .env и заполни - .env в .gitignore, сюда ключи не пишем.
#
# Нужен только для основного режима (npm run dev). Режим MCP (claude в корне проекта)
# работает под подпиской Claude Code и .env не читает.
#
# --- Провайдер модели -------------------------------------------------------
# Агент говорит по протоколу Anthropic Messages API. Достаточно задать один ключ -
# провайдер определится сам.

# Anthropic (Claude). Основной вариант: ТЗ требует модели Claude или OpenAI.
# Ключ: https://console.anthropic.com -> API Keys, оплата по использованию.
# OAuth-токен подписки Claude Code сюда класть нельзя: подписка разрешена только
# в клиентах Anthropic. Для работы по подписке есть режим MCP, см. README.
ANTHROPIC_API_KEY=

# z.ai (GLM). Для отладки: у z.ai есть бесплатные Flash-модели. Под ТЗ не подходит,
# GLM - не Claude и не OpenAI.
# Ключ: https://z.ai/manage-apikey/apikey-list
# ZAI_API_KEY=

# Явный выбор, если заданы оба ключа: anthropic | zai
# AGENT_PROVIDER=

# Переопределение моделей. По умолчанию у Anthropic: claude-sonnet-5 для агента,
# claude-haiku-4-5 для суб-агентов; у z.ai: glm-4.6 для обоих.
# Сильнее и в 2.5 раза дороже на Anthropic:
# AGENT_MODEL=claude-opus-5
# claude-opus-5-5 не ставить: он привязывает ход мысли к неизменной истории, а
# клиентский прунинг её правит. Новые аккаунты получат 400, как только прунинг сработает.
# Бесплатно на z.ai:
# AGENT_MODEL=glm-4.7-flash
# AGENT_SUB_MODEL=glm-4.5-flash

# --- Прочее -----------------------------------------------------------------
# Стартовая страница пустая по умолчанию: агент сам решает, куда идти.
# START_URL=about:blank

# Выключает серверный context editing. У несовместимых провайдеров он и так
# отключается автоматически, трогать не нужно.
# DISABLE_SERVER_CONTEXT_EDITING=1
