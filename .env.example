# Шаблон. Скопируй в .env и заполни - .env в .gitignore, сюда ключи не пишем.
#
# --- Провайдер модели -------------------------------------------------------
# Агент говорит по протоколу Anthropic Messages API. Его понимают и сама Anthropic,
# и совместимые шлюзы. Достаточно задать один ключ - провайдер определится сам.

# z.ai (GLM). Ключ: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Anthropic (Claude). Ключ: https://console.anthropic.com
# Подписка Claude Code сюда не подойдёт, нужен именно API-ключ.
# ANTHROPIC_API_KEY=

# Явный выбор, если заданы оба ключа: anthropic | zai
# AGENT_PROVIDER=

# Переопределение моделей: другой id или более дешёвая модель для суб-агентов.
# AGENT_MODEL=glm-4.6
# AGENT_SUB_MODEL=

# --- Прочее -----------------------------------------------------------------
# Стартовая страница пустая по умолчанию: агент сам решает, куда идти.
# START_URL=about:blank

# Выключает серверный context editing. У несовместимых провайдеров он и так
# отключается автоматически, трогать не нужно.
# DISABLE_SERVER_CONTEXT_EDITING=1
