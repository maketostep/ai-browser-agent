{
  "name": "ai-browser-agent",
  "displayName": "AI Browser Agent",
  "description": "Видимый Chrome под управлением Claude Code: дистилляция страницы, рефы элементов, подтверждение необратимых действий",
  "author": { "name": "maketostep", "url": "https://github.com/maketostep" },
  "homepage": "https://github.com/maketostep/ai-browser-agent",
  "repository": "https://github.com/maketostep/ai-browser-agent",
  "license": "ISC",
  "keywords": ["browser", "playwright", "chrome", "mcp", "automation"],
  "mcpServers": {
    "browser": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/node_modules/tsx/dist/cli.mjs",
        "--tsconfig",
        "${CLAUDE_PLUGIN_ROOT}/tsconfig.json",
        "${CLAUDE_PLUGIN_ROOT}/src/mcp.ts"
      ],
      "env": { "AGENT_PROFILE_DIR": "${CLAUDE_PLUGIN_DATA}/profile" }
    }
  }
}
